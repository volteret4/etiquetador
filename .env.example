# Copia este fichero a .env.

# Carpeta de música del anfitrión. Se monta en /music dentro del contenedor.
MUSICA=/ruta/a/tu/musica
# :ro hasta que revises el primer informe; vacíalo (MODO_MUSICA=) para que --write pueda escribir
MODO_MUSICA=:ro

# Rutas DENTRO del contenedor, separadas por «:»
# Carpetas cuyos discos procesa «pendientes» (cada subcarpeta es un disco)
TEMP_ROOTS=/music/entrada
# Carpetas de canciones sueltas (cada canción es su propio álbum; la orden «mix»)
LOOSE_ROOTS=
# Bandejas de entrada: sus subcarpetas son discos, pero lo suelto en la raíz no se procesa
INBOX_ROOTS=

# Opcional: también busca el sello en Discogs
DISCOGS_TOKEN=

# Uid:gid con permiso de escritura en tu música
UID_GID=1000:1000
